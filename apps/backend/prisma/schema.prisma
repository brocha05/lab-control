// ─────────────────────────────────────────────────────────────────────────────
// ACTIVE SCHEMA — only what is migrated: identity, clients/projects, catalogs,
// field capture (field records, deliveries, samples, specimens; 4.1) and tests (6.4).
//
// Reports still live in `prisma/drafts/domain.prisma`. Each later phase
// moves its models here with its own migration. Lab numbers (registro, muestra,
// espécimen) are consecutive per project (Q-55, Q-57, Q-58).
//
// Tenancy rules (docs/architecture/multi-tenancy.md, ADR-002):
//   - every tenant-owned table has tenant_id
//   - parents expose @@unique([id, tenantId]); children reference parents with
//     the composite (parentId, tenantId), so a child can never point at another
//     tenant's parent.
//   - tenantId is always the leading column of composite indexes.
// ─────────────────────────────────────────────────────────────────────────────

// Prisma 7 generator: the client is generated into src/ (gitignored) and compiled with
// the app. Regenerated on install (`postinstall`) and by `pnpm db:generate`.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// The lab's hierarchy (Q-39). The Auxiliar doesn't use the system.
/// Permissions (Q-40, Q-34): docs/domain/entities.md#roles.
enum UserRole {
  /// Jefe de Control de Calidad: authorizes and issues reports; administers users (A-81).
  QUALITY_MANAGER
  /// Coordinador del SGC: captures field records and tests.
  QMS_COORDINATOR
  /// Jefe de Laboratorio: signs worksheets and reports.
  LAB_MANAGER
  /// Jefe de Brigada de Campo (muestreador).
  FIELD_CREW_CHIEF
}

// ─── Tenant ─────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  /// IANA timezone used to compute "today" for scheduling. ASSUMPTION A-14.
  timezone  String
  /// Report header, e.g. "CONTROL DE CALIDAD Y PROYECTOS, S.A. DE C.V." (FPC06-04).
  legalName String?  @map("legal_name")
  /// Report footer address (FPC06-04).
  address   String?
  /// Report footer phone (FPC06-04).
  phone     String?
  // TBD: logos, accreditation data (Q-52). Signers: Q-37.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users                     User[]
  refreshTokens             RefreshToken[]
  clients                   Client[]
  projects                  Project[]
  projectTestConfigurations ProjectTestConfiguration[]
  holidays                  Holiday[]
  concreteSuppliers         ConcreteSupplier[]
  cementTypes               CementType[]
  fieldRecords              FieldRecord[]
  deliveries                Delivery[]
  samples                   Sample[]
  specimens                 Specimen[]
  specimenTests             SpecimenTest[]

  @@map("tenants")
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Globally unique, stored lowercase. ASSUMPTION A-32.
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  // TBD: signature image, title prefix ("DCC", "Ing.") and position for report
  //      signing (Q-37, Q-39)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("users")
}

// ─── RefreshToken (development-plan 2.3) ────────────────────────────────────
// Opaque random token handed to the client; only its SHA-256 is stored. Rotated on
// every refresh; reusing a revoked token revokes all of the user's tokens.

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// hex SHA-256 of the token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("refresh_tokens")
}

// ─── Client ("Solicitante" FPC01-01 / "Contratista" FPC06-04) ───────────────

model Client {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Legal name, e.g. "MARECOMSA S.A. DE C.V.".
  name         String
  /// 3–4 letter code, first segment of the report number ("MAR-…"). Q-56, A-76.
  code         String?
  /// FPC06-04 "Contacto" (name). ASSUMPTION A-70 (per client, not per project).
  contactName  String?  @map("contact_name")
  /// FPC06-04 "Contacto" (phone). ASSUMPTION A-70.
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("clients")
}

// ─── Project ("Obra") ───────────────────────────────────────────────────────

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// Official name as printed on the report (FPC06-04 "Proyecto"). Q-78.
  name      String
  /// 3–4 letter code, second segment of the report number ("…-PVLT-…"). Q-56, A-76.
  code      String?
  /// FPC01-01 "Obra y ubicación", location part.
  location  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant                     @relation(fields: [tenantId], references: [id])
  client             Client                     @relation(fields: [clientId, tenantId], references: [id, tenantId])
  testConfigurations ProjectTestConfiguration[]
  fieldRecords       FieldRecord[]
  samples            Sample[]
  specimens          Specimen[]

  @@unique([id, tenantId])
  @@unique([clientId, code])
  @@index([tenantId, clientId])
  @@map("projects")
}

// ─── ProjectTestConfiguration ───────────────────────────────────────────────
// One row per configured test age. ASSUMPTION A-10 (configured per project);
// general_flow.png says ages are configurable ("normalmente 2-7 a 2-28 días").
// Whether this is per project, per record, or a lab default is still Q-20.
// The migration adds CHECK (age_days > 0) and CHECK (specimen_count > 0).

model ProjectTestConfiguration {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  /// Positive integer number of days. No hardcoded values anywhere.
  ageDays       Int      @map("age_days")
  /// Specimens to test at this age. Q-14.
  specimenCount Int      @map("specimen_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([projectId, ageDays])
  @@index([tenantId, projectId])
  @@map("project_test_configurations")
}

// ─── Holiday (development-plan 4.0) ─────────────────────────────────────────
// A test date on a Sunday or holiday moves to the next day (Q-21). Which holidays
// apply is the lab's own list (Q-81, A-78).

model Holiday {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  date     DateTime @db.Date
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
  @@map("holidays")
}

// ─── Catalogs (development-plan 4.0; Q-06: pick from a list users can extend) ─

model ConcreteSupplier {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// e.g. "CEMEX".
  name     String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  fieldRecords FieldRecord[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@map("concrete_suppliers")
}

model CementType {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// e.g. "CPC-40".
  name     String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  fieldRecords FieldRecord[]
  deliveries   Delivery[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@map("cement_types")
}

// ─── Enums for field capture (development-plan 4.1) ─────────────────────────

/// COMPLETED = the paper record is signed (visto bueno) and transcribed (Q-33, Q-73).
enum FieldRecordStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

/// ASSUMPTION A-21 — "scheduled"/"tested" are derived from SpecimenTest rows.
enum SpecimenStatus {
  CREATED
  CANCELLED
}

/// FPC01-01 "Datos de proyecto": f'c (compression) or MR (modulus of rupture).
enum StrengthCriterion {
  FC
  MR
}

/// FPC01-02 "Hecho en obra" / "Premezclado". Entered by the Bitácora clerk (Q-07).
enum ConcreteProduction {
  SITE_MIXED
  READY_MIXED
}

/// FPC01-01 "Condiciones ambientales", first group. ASSUMPTION A-64 (single choice).
enum SkyCondition {
  SUNNY
  CLOUDY
  RAINY
}

/// FPC01-01 "Condiciones ambientales", second group. ASSUMPTION A-64.
enum WindCondition {
  WINDY
  CALM
}

/// FPC01-01 "Condiciones ambientales", third group. ASSUMPTION A-64.
enum LightingCondition {
  NATURAL
  ARTIFICIAL
}

/// FPC01-01 "Referencia de los especímenes — Tipo" (nominal size in cm), plus the
/// 10 cm cube the lab also tests (Q-70). Only cylinders in compression are in scope now.
enum SpecimenType {
  CYLINDER_15X30
  CYLINDER_10X20
  BEAM_15X60
  BEAM_15X50
  CUBE_15
  CUBE_10
}

// ─── FieldRecord (FPC01-01 "Registro de campo para la recepción de concreto
//     hidráulico") ─────────────────────────────────────────────────────────
// One record per pour (colado), filled on paper on site and transcribed later
// (Q-49). Can span several sheets of 7 deliveries each (Q-71, Q-77); the sheet
// number is derived from the delivery sequence.

model FieldRecord {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  status    FieldRecordStatus @default(DRAFT)

  /// "Registro" number: printed "MCH-068" (MCH = Muestreo de Concreto Hidráulico).
  /// Consecutive per project from 1, assignable automatically (Q-55). Per front? Q-79.
  registrySequence Int?                @map("registry_sequence")
  /// Front of the project ("F1" in the report number). Q-56, A-79.
  frontNumber      Int                 @default(1) @map("front_number")
  /// "Fecha del colado". Date-only. Test-age reference date (A-11, A-12).
  pourDate         DateTime            @map("pour_date") @db.Date
  /// "Proveedor" (catalog, Q-06).
  supplierId       String?             @map("supplier_id") @db.Uuid
  /// "Hecho en obra" / "Premezclado" (Q-07).
  production       ConcreteProduction?

  // "Datos de proyecto" — specified values (A-75).
  strengthCriterion         StrengthCriterion? @map("strength_criterion")
  /// f'c or MR, kgf/cm².
  specifiedStrengthKgCm2    Decimal?           @map("specified_strength_kg_cm2") @db.Decimal(6, 1)
  /// "Revenimiento (cm)", nominal value of "14.0 ± 3.5".
  specifiedSlumpCm          Decimal?           @map("specified_slump_cm") @db.Decimal(4, 1)
  /// Tolerance part of "14.0 ± 3.5".
  specifiedSlumpToleranceCm Decimal?           @map("specified_slump_tolerance_cm") @db.Decimal(4, 1)
  /// "Tamaño máximo del agregado (mm)". FPC01-02 prints it in cm.
  maxAggregateSizeMm        Decimal?           @map("max_aggregate_size_mm") @db.Decimal(5, 1)
  /// "Tipo cemento" (catalog, Q-06).
  cementTypeId              String?            @map("cement_type_id") @db.Uuid
  /// "Edad definitiva (días)": age at which the supplier guarantees f'c (Q-74).
  /// Informative; test ages are chosen by the user.
  designAgeDays             Int?               @map("design_age_days")

  /// "Cribado": the concrete was screened through a mesh before placing (Q-76).
  screened   Boolean?
  /// "Malla" used for screening.
  screenMesh String?  @map("screen_mesh")

  // "Condiciones ambientales"
  skyCondition        SkyCondition?      @map("sky_condition")
  windCondition       WindCondition?     @map("wind_condition")
  lightingCondition   LightingCondition? @map("lighting_condition")
  /// "Humedad (%)".
  relativeHumidityPct Decimal?           @map("relative_humidity_pct") @db.Decimal(4, 1)

  // "Trazabilidad (*calibrada, #verificada)" — equipment codes as written. No
  // equipment catalog to start (Q-29, A-65).
  thermometerCode  String? @map("thermometer_code")
  hygrometerCode   String? @map("hygrometer_code")
  slumpConeCode    String? @map("slump_cone_code")
  tapeMeasureCode  String? @map("tape_measure_code")
  strikeOffBarCode String? @map("strike_off_bar_code")
  slumpRodCode     String? @map("slump_rod_code")
  samplingRodCode  String? @map("sampling_rod_code")
  wheelbarrowCode  String? @map("wheelbarrow_code")

  // Unit weight, NMX-C-162-ONNCCE-2014 box. Rarely measured (Q-67).
  // Derived: (tare + sample − tare) × mold factor.
  unitWeightScaleCode   String?  @map("unit_weight_scale_code")
  unitWeightMoldCode    String?  @map("unit_weight_mold_code")
  unitWeightTareG       Decimal? @map("unit_weight_tare_g") @db.Decimal(9, 1)
  unitWeightTareSampleG Decimal? @map("unit_weight_tare_sample_g") @db.Decimal(9, 1)
  unitWeightMoldFactor  Decimal? @map("unit_weight_mold_factor") @db.Decimal(10, 4)

  // Air content, NMX-C-157-ONNCCE-2012 box (read from the meter).
  airMeterCode  String?  @map("air_meter_code")
  airContentPct Decimal? @map("air_content_pct") @db.Decimal(4, 1)

  /// "Elemento(s) programado(s)".
  programmedElement String? @map("programmed_element")
  /// "Elemento(s) colado(s)". Printed on FPC01-02, FPC06-01 and FPC06-04.
  castElement       String? @map("cast_element")
  /// "Observaciones".
  observations      String?
  /// "Muestreador" (name as written on paper).
  samplerName       String? @map("sampler_name")
  /// "Visto bueno": usually the client, else a lab Technical Signatory (Q-73).
  approvedByName    String? @map("approved_by_name")
  // TBD: "Croquis de colocación" as an optional attachment (Q-72).

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  project    Project           @relation(fields: [projectId, tenantId], references: [id, tenantId])
  supplier   ConcreteSupplier? @relation(fields: [supplierId, tenantId], references: [id, tenantId])
  cementType CementType?       @relation(fields: [cementTypeId, tenantId], references: [id, tenantId])
  deliveries Delivery[]

  @@unique([id, tenantId])
  @@unique([projectId, registrySequence])
  @@index([tenantId, projectId, pourDate])
  @@index([tenantId, status])
  @@map("field_records")
}

// ─── Delivery ("Entrega": one row of the FPC01-01 table) ────────────────────
// One truck / batch (A-60). Cumulative volume and the sheet number
// (ceil(sequence / 7), Q-71) are derived. Times are time-of-day on the pour date (A-66).

model Delivery {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  fieldRecordId        String    @map("field_record_id") @db.Uuid
  /// "Número de la entrega" (1, 2, 3…), continuous across the record's sheets.
  sequence             Int
  /// "Identificación del medio de entrega: remisión > placas < (número)".
  ticketNumber         String?   @map("ticket_number")
  /// "Volumen de la unidad (m³)".
  volumeM3             Decimal?  @map("volume_m3") @db.Decimal(6, 2)
  /// "Salida planta" (ready-mix) or "hechura" (site-mixed). ASSUMPTION A-66.
  plantDepartureTime   DateTime? @map("plant_departure_time") @db.Time(0)
  /// "Llegada obra" (ready-mix) or "disponible" (site-mixed). Age-tolerance fallback (Q-62).
  siteArrivalTime      DateTime? @map("site_arrival_time") @db.Time(0)
  /// "Colado — inicio".
  pourStartTime        DateTime? @map("pour_start_time") @db.Time(0)
  /// "Colado — término".
  pourEndTime          DateTime? @map("pour_end_time") @db.Time(0)
  /// "Temperatura ambiente (°C)".
  ambientTemperatureC  Decimal?  @map("ambient_temperature_c") @db.Decimal(4, 1)
  /// "Temperatura concreto (°C)".
  concreteTemperatureC Decimal?  @map("concrete_temperature_c") @db.Decimal(4, 1)
  /// "Revenimiento obtenido (cm)", reading 1.
  slump1Cm             Decimal?  @map("slump_1_cm") @db.Decimal(4, 1)
  /// Reading 2: only when the test is repeated. Never averaged; both are reported (Q-66).
  slump2Cm             Decimal?  @map("slump_2_cm") @db.Decimal(4, 1)

  // "Datos de remisión": this truck's delivery ticket (Q-65).
  ticketStrengthKgCm2    Decimal? @map("ticket_strength_kg_cm2") @db.Decimal(6, 1)
  ticketSlumpCm          Decimal? @map("ticket_slump_cm") @db.Decimal(4, 1)
  ticketSlumpToleranceCm Decimal? @map("ticket_slump_tolerance_cm") @db.Decimal(4, 1)
  ticketMaxAggregateMm   Decimal? @map("ticket_max_aggregate_mm") @db.Decimal(5, 1)
  ticketCementTypeId     String?  @map("ticket_cement_type_id") @db.Uuid
  ticketDesignAgeDays    Int?     @map("ticket_design_age_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  fieldRecord      FieldRecord @relation(fields: [fieldRecordId, tenantId], references: [id, tenantId])
  ticketCementType CementType? @relation(fields: [ticketCementTypeId, tenantId], references: [id, tenantId])
  samples          Sample[]

  @@unique([id, tenantId])
  @@unique([fieldRecordId, sequence])
  @@index([tenantId, fieldRecordId])
  @@map("deliveries")
}

// ─── Sample ("Muestra") ─────────────────────────────────────────────────────
// Taken from one delivery (A-61). A record can have several samples, each on its
// own report page (Q-71).

model Sample {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  deliveryId   String        @map("delivery_id") @db.Uuid
  /// Copy of the record's project, for the per-project number constraint (Q-57).
  projectId    String        @map("project_id") @db.Uuid
  /// "No. muestra", e.g. 102. Consecutive per project; assigned when the record is
  /// captured (Q-57).
  sampleNumber Int?          @map("sample_number")
  /// "Tipo" (A-63: one type per sample).
  specimenType SpecimenType? @map("specimen_type")
  /// "Hora de elaboración": start of the age-tolerance window (Q-62).
  moldedAt     DateTime?     @map("molded_at") @db.Time(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  delivery  Delivery   @relation(fields: [deliveryId, tenantId], references: [id, tenantId])
  project   Project    @relation(fields: [projectId, tenantId], references: [id, tenantId])
  specimens Specimen[]

  @@unique([id, tenantId])
  @@unique([projectId, sampleNumber])
  @@index([tenantId, deliveryId])
  @@map("samples")
}

// ─── Specimen ("Espécimen": cylinder, beam or cube) ─────────────────────────

model Specimen {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  sampleId       String         @map("sample_id") @db.Uuid
  /// Copy of the record's project, for the per-project number constraint (Q-58).
  projectId      String         @map("project_id") @db.Uuid
  status         SpecimenStatus @default(CREATED)
  /// "Clave espécimen" / "Número de espécimen", e.g. 405. Consecutive per project (Q-58).
  specimenNumber Int?           @map("specimen_number")
  /// "Clave molde", e.g. "020": a reusable physical mold, paired by position (A-62).
  moldCode       String?        @map("mold_code")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  sample  Sample         @relation(fields: [sampleId, tenantId], references: [id, tenantId])
  project Project        @relation(fields: [projectId, tenantId], references: [id, tenantId])
  tests   SpecimenTest[]

  @@unique([id, tenantId])
  @@unique([projectId, specimenNumber])
  @@index([tenantId, sampleId])
  @@map("specimens")
}

// ─── Lab testing (development-plan 6.4) ─────────────────────────────────────

/// ASSUMPTION A-22 — no form shows an "in progress" state; may be dropped.
enum SpecimenTestStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── SpecimenTest (one row of FPC06-01 "Registro de resultados de resistencia
//     a la compresión de especímenes ensayados (cilindros)") ─────────────────
// Each specimen is tested once (Q-16); 1:N stays so a cancelled test can be
// replanned (A-05). The scheduled DATE is derived: pourDate + ageDays, moved past
// Sundays/holidays unless `keepExactDate` (Q-21). Age tolerance (Q-62) is derived
// from the sample's molding time and `testDate` + `testTime`.

model SpecimenTest {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  specimenId         String             @map("specimen_id") @db.Uuid
  /// "Edad (días)". Copied from the project's default ages when planned; editable
  /// until the test is completed (Q-22, A-15).
  ageDays            Int                @map("age_days")
  /// Test on the exact age even on a Sunday/holiday (client requirement, Q-21).
  keepExactDate      Boolean            @default(false) @map("keep_exact_date")
  status             SpecimenTestStatus @default(SCHEDULED)
  /// "Fecha de ensayos".
  testDate           DateTime?          @map("test_date") @db.Date
  /// Time of the break, for the age tolerance (Q-62). Not printed on FPC06-01.
  testTime           DateTime?          @map("test_time") @db.Time(0)
  /// "Altura (cm)", reading 1.
  height1Cm          Decimal?           @map("height_1_cm") @db.Decimal(4, 1)
  /// "Altura (cm)", reading 2.
  height2Cm          Decimal?           @map("height_2_cm") @db.Decimal(4, 1)
  /// "Diámetro (cm)", reading 1.
  diameter1Cm        Decimal?           @map("diameter_1_cm") @db.Decimal(4, 1)
  /// "Diámetro (cm)", reading 2.
  diameter2Cm        Decimal?           @map("diameter_2_cm") @db.Decimal(4, 1)
  /// "Carga máxima registrada — kgf": the press reading (Q-61). N is derived.
  maxLoadKgf         Decimal?           @map("max_load_kgf") @db.Decimal(9, 1)
  /// "Tiempo (s)": spot check on 1 of every 10 specimens tested in a day (Q-63).
  loadDurationS      Int?               @map("load_duration_s")
  /// "Tipo de falla" (NMX-C-083 pattern). The worksheet is authoritative (Q-60).
  failureType        Int?               @map("failure_type") @db.SmallInt
  /// "Prensa", e.g. "CCP-PRE-05". One press, direct readings (Q-75).
  pressCode          String?            @map("press_code")
  /// "Dimensiones" instruments, e.g. "CCP-FLX-01, CCP-RME-02".
  dimensionEquipment String?            @map("dimension_equipment")
  performedById      String?            @map("performed_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  specimen Specimen @relation(fields: [specimenId, tenantId], references: [id, tenantId])

  @@index([tenantId, status])
  @@index([tenantId, specimenId])
  @@index([tenantId, testDate])
  @@map("specimen_tests")
}
