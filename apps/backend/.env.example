# Copy to .env (never commit .env). Validated on boot by src/shared/config/env.validation.ts.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Matches the root docker-compose.yml defaults.
DATABASE_URL=postgresql://lab:lab@localhost:5432/lab_control?schema=public

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Auth (development-plan 2.3). Use a long random value outside development, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Report PDFs (Phase 9, ADR-005/006). "local" keeps them in REPORT_STORAGE_DIR; "s3" uses
# S3 or the docker-compose MinIO (endpoint http://localhost:9000, create the bucket first).
REPORT_STORAGE_DRIVER=local
REPORT_STORAGE_DIR=storage/reports
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=lab-control-reports
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# HTML → PDF with headless Chromium: run `pnpm exec playwright-core install chromium-headless-shell`
# once, or point PDF_CHROMIUM_PATH at an installed Chrome. "stub" skips the browser (tests).
PDF_RENDERER=playwright
# PDF_CHROMIUM_PATH=
